{
  "name": "baby-daybook-garmin-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e:auth-build": "node scripts/build-authenticated-e2e.mjs fenix7 Victoria",
    "e2e:smoke": "npm run garmin-pilot:build && node scripts/garmin-e2e-smoke.mjs",
    "e2e:input": "npm run garmin-pilot:build && node scripts/garmin-input-e2e.mjs",
    "e2e:scenario": "npm run garmin-pilot:build && node scripts/capture-scenario.mjs",
    "e2e:scenario-build": "node scripts/build-scenario.mjs",
    "e2e:scenario-matrix": "npm run garmin-pilot:build && node scripts/capture-scenario-matrix.mjs",
    "e2e:scenario-verify": "python3 scripts/verify-scenario-screenshots.py",
    "e2e:picker": "npm run garmin-pilot:build && node scripts/verify-bottle-picker-interaction.mjs",
    "e2e:relay-live": "node scripts/verify-live-relay.mjs",
    "garmin-pilot:build": "npm --prefix tools/garmin-pilot run build",
    "garmin-pilot:test": "npm --prefix tools/garmin-pilot test",
    "garmin:browser": "node scripts/restore-garmin-browser-session.mjs",
    "garmin:browser:status": "node scripts/restore-garmin-browser-session.mjs --status",
    "garmin:browser-upload": "node scripts/inject-garmin-browser-upload.mjs",
    "garmin:login": "node scripts/publish-garmin-beta.mjs --login",
    "garmin:publish": "node scripts/publish-garmin-beta.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.54.1"
  }
}
