{
  "name": "garmin-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright-like automation for the Garmin Connect IQ simulator",
  "type": "module",
  "bin": { "garmin-pilot": "dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./toolcraft": { "types": "./dist/toolcraft.d.ts", "import": "./dist/toolcraft.js" }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/toolcraft.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "toolcraft": "0.0.163" },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
